<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:l="/lib/layout">
    <div class="alert alert-danger">
        <form method="post" action="${rootURL}/${it.url}/disable" style="float:right;">
            <f:submit value="${%Dismiss}"/>
        </form>
        <strong>The Jenkins Artifactory plugin is deprecated.</strong>
        It is no longer the recommended way to integrate Jenkins with the JFrog Platform.
        Please install the
        <a href="https://plugins.jenkins.io/jfrog/" target="_blank" rel="noopener">JFrog plugin</a>,
        which wraps the JFrog CLI and receives all new features.
        Existing pipelines continue to work.
        See the
        <a href="https://docs.jfrog-applications.jfrog.io/ci-and-sdks/ci-integrations/jenkins-jfrog-plugin"
           target="_blank" rel="noopener">migration guide</a>.
    </div>
</j:jelly>
